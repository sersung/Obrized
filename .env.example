# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://seudominio.com
NEXTAUTH_URL=https://seudominio.com
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=substitua-por-string-aleatoria-longa

# ── IA (Gemini — gratuito 1500 req/dia) ──────────────────────────────────────
GEMINI_API_KEY=sua-chave-gemini-aqui

# ── Email SMTP ────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu@email.com
# Senha de app do Gmail (16 digitos, não a senha normal)
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=Obrized <seu@email.com>

# ── Stripe (opcional — só para cobrar clientes) ───────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...

# ── Analytics (opcional) ──────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
